ecommerce_poc:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "<your-account-identifier>"
      user: "<your-snowflake-username>"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: ACCOUNTADMIN
      warehouse: COMPUTE_WH
      database: ECOMMERCE_POC_DB
      schema: MARTS
      threads: 4
